# Copiez ce fichier, renseignez vos valeurs, puis exportez-les dans l'environnement du serveur.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacez-par-une-longue-cle-aleatoire
DJANGO_ALLOWED_HOSTS=votre-domaine.sn
DJANGO_CSRF_TRUSTED_ORIGINS=https://votre-domaine.sn
# PostgreSQL (production). Sans POSTGRES_DB, SQLite est utilisé.
POSTGRES_DB=jec
POSTGRES_USER=jec
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Assistant JEC (chatbot) : cle API Anthropic, a ne jamais mettre dans le code
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Autre IA compatible OpenAI (ex. Google Gemini, Groq, Ollama en local) - alternative a Anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Adresse publique du site (encodee dans le QR code de l'application mobile)
SITE_URL=https://votre-domaine.sn
